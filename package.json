{
  "name": "iron-dome",
  "version": "1.0.0",
  "description": "100% Serverless NestJS API for Fintech/SaaS — Iron Dome Architecture",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "rimraf dist && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "stop": "docker-compose down",
    "infra": "docker-compose up -d",
    "format": "prettier -w '**/*.{ts,js,cjs,mjs,json,yml,md}'",
    "lint": "eslint '{src,test}/**/*.ts'",
    "lint:fix": "eslint '{src,test}/**/*.ts' --fix",
    "test": "jest",
    "test:unit": "jest --config jest-unit.json --passWithNoTests",
    "test:integrated": "NODE_OPTIONS=--experimental-vm-modules jest --config jest-int.json --passWithNoTests",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "release": "semantic-release",
    "seed": "npx ts-node scripts/seed.ts",
    "ci": "bash scripts/ci-local.sh"
  },
  "keywords": [],
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/testing": "^11.1.17",
    "@playwright/test": "^1.58.2",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.4.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-sonarjs": "^4.0.1",
    "husky": "^9.1.7",
    "i18next": "^25.8.17",
    "i18next-fs-backend": "^2.6.1",
    "jest": "^30.3.0",
    "lint-staged": "^16.3.2",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.3",
    "supertest": "^7.2.2",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1013.0",
    "@aws-sdk/client-dynamodb": "^3.1005.0",
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/client-secrets-manager": "^3.1005.0",
    "@aws-sdk/client-sns": "^3.1005.0",
    "@aws-sdk/client-sqs": "^3.1005.0",
    "@aws-sdk/util-dynamodb": "^3.996.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "openai": "^6.27.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "lint-staged": {
    "**/*.{ts,js,cjs,mjs,json,yml,md}": [
      "prettier --write"
    ],
    "{src,test}/**/*.ts": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "@nestjs/cli": {
      "ajv": "^8.18.0"
    },
    "@nestjs/schematics": {
      "ajv": "^8.18.0"
    },
    "glob": "^10.5.0",
    "tar": "^7.5.10",
    "minimatch": "^10.2.4",
    "path-to-regexp": "^8.4.0"
  }
}
